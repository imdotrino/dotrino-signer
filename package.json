{
  "name": "dotrino-signer",
  "version": "0.1.0",
  "description": "Autoridad de sello de tiempo (TSA) del ecosistema Dotrino: firma { hash, ts } con la clave del sellador para probar cuándo existió un contenido, sin verlo. Servidor desplegado en signer.dotrino.com.",
  "type": "module",
  "main": "server.js",
  "files": [
    "server.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "dotrino",
    "signer",
    "timestamp",
    "tsa",
    "ecdsa",
    "seal"
  ],
  "author": "seyacat",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imdotrino/dotrino-signer.git"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@dotrino/update": "0.7.0"
  }
}
